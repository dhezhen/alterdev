Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep project files private when the hosting root points here instead of /public.
    RewriteRule ^$ public/index.php [L]
    RewriteCond %{REQUEST_URI} !^/public/?$ [NC]
    RewriteCond %{REQUEST_URI} !^/public/ [NC]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
